# ---- Core ----
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (the Vite app).
CORS_ORIGIN=http://localhost:3005

# ---- Database (Postgres) ----
# Local example: postgres://USER:PASSWORD@localhost:5432/sbxprime
DATABASE_URL=postgres://localhost:5432/sbxprime
# Set to "require" when your provider needs SSL (most managed Postgres do).
PGSSLMODE=disable

# Investor numbers start here (the site shows ~120 early pledges).
INVESTOR_NUMBER_START=121

# ---- Email (SMTP; works with Postmark, SendGrid, Resend, etc.) ----
# Leave SMTP_HOST blank in dev to print emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Addresses used on outgoing mail.
MAIL_FROM="SBX Prime <hello@sbxprime.com>"
MAIL_TEAM=team@sbxprime.com
