# ---- Core ----
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (the Vite app).
CORS_ORIGIN=http://localhost:3005

# ---- Database (Postgres) ----
# Local example: postgres://USER:PASSWORD@localhost:5432/sbxprime
DATABASE_URL=postgres://localhost:5432/sbxprime
# Set to "require" when your provider needs SSL (most managed Postgres do).
PGSSLMODE=disable

# Investor numbers start here (the site shows ~120 early pledges).
INVESTOR_NUMBER_START=121

# ---- Email (Resend HTTP API) ----
# Leave RESEND_API_KEY blank in dev to print emails to the console instead of
# sending. Prefer a dedicated SBX Prime key (Resend → API Keys → Create,
# scope: Sending access) over the shared superblock.ai key.
RESEND_API_KEY=
# From address must be on a domain verified in Resend. Until sbxprime.com is
# verified you may temporarily use "SUPERBLOCK <no-reply@mail.superblock.ai>".
MAIL_FROM="SBX Prime <no-reply@mail.sbxprime.com>"
# Where replies go. Leave BLANK for a genuine send-only (no-reply) sender.
# If set, it MUST be a real, monitored inbox or replies bounce.
MAIL_REPLY_TO=
# Optional: internal address that receives a copy/notice of each new pledge.
MAIL_TEAM=team@sbxprime.com
